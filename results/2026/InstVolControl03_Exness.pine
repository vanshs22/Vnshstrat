//@version=6
strategy("inst-vol_control-03 | Exness Research Symbols", overlay=true,
     initial_capital=100000, pyramiding=0, process_orders_on_close=false,
     commission_type=strategy.commission.percent, commission_value=0.02,
     slippage=3, calc_on_order_fills=false)

// Public research implementation of the existing inst-vol_control-03 logic.
// Apply one chart per symbol. Pine strategies cannot place true multi-symbol
// orders from one strategy account; use alerts or the MT5 EA for the portfolio.
asset = input.string("EURUSDm", "Exness symbol", options=["EURUSDm", "XAUUSDm", "US500m", "USTECm"])
momentumLength = input.int(252, "Momentum lookback", minval=20)
volLength = input.int(63, "Volatility lookback", minval=10)
trendLength = input.int(200, "Trend SMA", minval=50)
targetVolPct = input.float(5.0, "Target annualized volatility %", minval=0.1, step=0.1)
maxExposure = input.float(150.0, "Maximum exposure %", minval=10, maxval=300, step=5)
riskBudgetPct = input.float(0.50, "Risk budget %", minval=0.05, maxval=1.0, step=0.05)
maxDailyLossPct = input.float(2.5, "Daily loss lock %", minval=0.1, step=0.1)
maxDrawdownPct = input.float(6.5, "Maximum drawdown lock %", minval=0.1, step=0.1)
// Set this to the verified Exness contract point value for the chart symbol.
pointValue = input.float(1.0, "Point value", minval=0.000001)

logRet = math.log(close / close[1])
annualVol = ta.stdev(logRet, volLength) * math.sqrt(252.0)
momentum = not na(close[momentumLength]) ? close / close[momentumLength] - 1 : na
trend = ta.sma(close, trendLength)
eligible = not na(annualVol) and not na(momentum) and not na(trend) and annualVol > 0 and momentum > 0 and close > trend
exposure = eligible ? math.min(maxExposure / 100.0, (targetVolPct / 100.0) / annualVol) : 0.0

var float dayStartEquity = na
var float peakEquity = strategy.initial_capital
var bool dailyLock = false
var bool totalLock = false
var int lastRebalanceMonth = na

newDay = ta.change(time("D")) != 0
if barstate.isfirst or newDay
    dayStartEquity := strategy.equity
    dailyLock := false
peakEquity := math.max(peakEquity, strategy.equity)
if strategy.equity <= dayStartEquity * (1 - maxDailyLossPct / 100)
    dailyLock := true
if strategy.equity <= peakEquity * (1 - maxDrawdownPct / 100)
    totalLock := true

newMonth = ta.change(time("M")) != 0
if newMonth and not dailyLock and not totalLock
    if eligible
        qty = pointValue > 0 ? strategy.equity * math.min(exposure, riskBudgetPct / 100.0 * 2.0) / (close * pointValue) : na
        strategy.entry("Rotation Long", strategy.long, qty=qty)
    else
        strategy.close("Rotation Long", comment="Regime exit")
    lastRebalanceMonth := month(time)

if dailyLock or totalLock
    strategy.close("Rotation Long", comment=totalLock ? "Max DD lock" : "Daily DD lock")

plot(trend, "Trend SMA", color=color.orange)
plot(exposure * 100, "Exposure %", color=color.aqua, display=display.data_window)
plotshape(newMonth and eligible, "Eligible rebalance", shape.triangleup, location.belowbar, color=color.lime, size=size.tiny)
